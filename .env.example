# ========================================================
# CodingHub Backend (Express) - Environment Variables
# ========================================================

# Port for local development (not used on Vercel serverless)
PORT=5000

# Database Configuration
# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0
DB_NAME=CodingHub

# Frontend Origins (no trailing slashes)
# Used for CORS and session validation
# Local: http://localhost:3000
# Production: https://<your-frontend-project>.vercel.app
FRONTEND_URL=https://<your-frontend-project>.vercel.app
CLIENT_URL=https://<your-frontend-project>.vercel.app

# Better Auth Verification Endpoint Base URL (no trailing slash)
# Points to the frontend where Better Auth runs (/api/auth/get-session)
# Local: http://localhost:3000
# Production: https://<your-frontend-project>.vercel.app
BETTER_AUTH_URL=https://<your-frontend-project>.vercel.app

